{
  "name": "trinket",
  "version": "0.0.0",
  "description": "the key to open education",
  "main": "app/app.js",
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=22.12.0 <23.0.0",
    "npm": ">=10.0.0 <11.0.0"
  },
  "packageManager": "npm@10.9.9",
  "dependencies": {
