# Reproducible toolchain (AAP G1, R-2). These two settings are half of the pin; the other half is
# package.json's `engines` block and its exact `packageManager` value, and neither half works alone.
#
# engine-strict turns `engines` from advice into an enforced gate, so `npm ci` FAILS rather than warns
# when the interpreter or the package manager is outside the declared range. That is deliberate: the
# declared range is node >=22.12.0 <23.0.0 and npm >=10.0.0 <11.0.0, and `packageManager` pins the exact
# release the lockfile and the container image are built with, npm@10.9.9.
#
# A checkout whose default npm is 11 will therefore be refused, with EBADENGINE naming both the required
# and the actual version. That is the pin doing its job, not a misconfiguration. Switch the toolchain
# rather than relaxing the range:
#
#     corepack enable npm && corepack use npm@10.9.9
#   or
#     npm install -g npm@10.9.9
#
# save-exact records every dependency at an exact version, so `npm install <pkg>` cannot silently widen a
# range that the committed lockfileVersion-3 lockfile then has to pin again.
engine-strict=true
save-exact=true
