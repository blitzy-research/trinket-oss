    "accepts": "1.3.8",
    "adm-zip": "0.6.0",
    "archiver": "7.0.1",
    "bcrypt": "6.0.0",
    "bull": "4.16.5",
    "config": "0.4.37",
    "crypto-js": "4.2.0",
    "csv": "6.6.1",
    "diff": "9.0.0",
    "escape-string-regexp": "1.0.5",
    "highlight.js": "9.18.5",
    "joi": "18.2.3",
    "js-yaml": "3.15.1",
    "jsonwebtoken": "9.0.3",
    "jszip": "3.10.1",
    "limax": "1.4.1",
    "lodash": "4.18.1",
    "marked": "4.3.0",
    "mime": "1.6.0",
    "moment": "2.30.1",
    "mongoose": "6.13.10",
    "mongoose-schema-extend": "0.2.2",
    "nodemailer": "9.0.3",
    "numeral": "1.5.6",
    "nunjucks": "3.2.4",
    "redis": "4.7.1",
    "tmp": "0.2.7",
    "transliteration": "0.1.1",
    "underscore": "1.13.8",
    "validator": "13.15.35",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "chai": "4.5.0",
    "chai-as-promised": "7.1.2",
    "chokidar": "3.6.0",
    "mocha": "11.7.6",
    "redis-mock": "0.56.3",
    "sass": "1.98.0",
    "sinon": "22.1.0",
    "sinon-chai": "3.7.0",
    "supertest": "7.2.2",
    "vite": "4.5.14"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "diff": "9.0.0",
    "serialize-javascript": "7.0.7"
  },
  "scripts": {
    "test": "NODE_ENV=test NODE_CONFIG_PERSIST_ON_CHANGE=N mocha --file ./test/setup.js",
