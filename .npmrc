# Reproducible install settings for the Node 22 LTS toolchain.
# engine-strict makes the "engines" range in package.json a hard gate instead of a warning,
# so an unsupported Node/npm combination fails fast rather than producing a subtly broken tree.
engine-strict=true

# Any dependency added later is written to package.json as an exact version, keeping
# package.json and package-lock.json in lock-step for `npm ci`.
save-exact=true
