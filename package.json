{
  "name": "trinket",
  "version": "0.0.0",
  "description": "the key to open education",
  "main": "app/app.js",
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0 <11.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.0",
    "@hapi/hapi": "^21.4.10",
    "@hapi/inert": "^7.0.0",
    "@hapi/vision": "^7.0.0",
    "@hapi/yar": "^11.0.0",
    "accepts": "^1.3.8",
    "adm-zip": "^0.6.0",
    "archiver": "^6.0.2",
    "aws-sdk": "^2.1.20",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "config": "~0.4.35",
    "csv": "^6.4.1",
    "diff": "^8.0.4",
    "escape-string-regexp": "~1.0.5",
    "highlight.js": "^9.6.0",
    "joi": "^18.2.5",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "~3.6.0",
    "limax": "~1.4.0",
    "lodash": "^4.18.1",
    "marked": "git+https://github.com/trinketapp/marked.git",
    "mime": "^4.1.0",
    "moment": "^2.18.1",
    "mongoose": "^6.0.0",
    "mongoose-schema-extend": "~0.2.2",
    "node-cryptojs-aes": "^0.4.0",
    "nodemailer": "^9.1.0",
    "numeral": "^1.5.3",
    "nunjucks": "^3.2.0",
    "q": "~1.0.0",
    "redis": "^4.0.0",
    "tab": "~0.1.0",
    "tmp": "^0.2.7",
    "transliteration": "^0.1.1",
    "underscore": "^1.8.3",
    "validator": "^13.15.35",
    "winston": "^3.8.0"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "mocha": "^3.4.1",
    "mongodb-memory-server": "11.2.0",
    "redis-mock": "~0.2.0",
    "sass": "^1.57.0",
    "sinon": "^22.1.0",
    "supertest": "~0.8.3",
    "vite": "^4.5.14"
  },
  "scripts": {
    "test": "node test/parity/mongo.js -- mocha",
    "build:css": "vite build",
    "watch:css": "vite build --watch",
    "fetch-components": "node scripts/fetch-components.js",
    "build": "npm run fetch-components && npm run build:css",
    "make-admin": "node scripts/make-admin.js",
    "verify:routes": "mkdir -p ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity} && NODE_ENV=test NODE_CONFIG='{\"db\":{\"redis\":{\"enabled\":false}}}' node test/parity/manifest.js --out ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity}/route-manifest.json >/dev/null && NODE_ENV=test NODE_CONFIG='{\"db\":{\"redis\":{\"enabled\":false}}}' node test/parity/manifest.js --compare test/parity/route-manifest.baseline.json ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity}/route-manifest.json",
    "verify:corpus": "mkdir -p ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity} && node test/parity/replay.js --app . --corpus test/parity/corpus.json --annotations test/parity/corpus.json --manifest ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity}/route-manifest.json --out ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity}/replay-result.json --report ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity}/replay-report.txt --port ${PARITY_PORT:-3010}",
    "verify:joi": "mkdir -p ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity} && node test/parity/joi-matrix.js --compare test/parity/joi-baseline.json --out ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity}/joi-comparison.json --port ${PARITY_PORT:-3010}",
    "verify:storage": "mkdir -p ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity} && node test/parity/storage.js --out ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity}/storage-result.json",
    "verify:worker": "mkdir -p ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity} && node test/parity/worker.js --out ${PARITY_OUT:-${TMPDIR:-/tmp}/trinket-parity}/worker-result.json",
    "verify:parity": "rc=0; for gate in routes corpus joi storage worker; do echo \"== verify:$gate ==\"; npm run --silent verify:$gate || rc=1; done; if [ \"$rc\" -ne 0 ]; then echo \"verify:parity FAILED - at least one gate above did not pass\"; fi; exit \"$rc\""
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/trinketapp/trinket-oss.git"
  },
  "keywords": [
    "education",
    "nodejs",
    "mongodb"
  ],
  "author": "bzwheeler",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trinketapp/trinket-oss/issues"
  },
  "homepage": "https://github.com/trinketapp/trinket-oss"
}
