# engine-strict makes package.json's `engines` range an enforced gate rather than advice, so `npm ci`
# fails with EBADENGINE instead of warning when the interpreter or package manager is out of range.
# Switch the toolchain to the pinned `packageManager` release rather than relaxing the range; docs/setup.md
# gives the commands.
#
# save-exact records every dependency at an exact version, so `npm install <pkg>` cannot widen a range
# that the committed lockfile then has to pin again.
engine-strict=true
save-exact=true
